# Адреса должны быть доступны ИЗ контейнера.
# Для серверов на Windows-хосте Docker Desktop:
PARAKEET_URL=http://host.docker.internal:8083
NEMOTRON_URL=http://host.docker.internal:8090
# Необязательно: метка версии/модели Nemotron для манифеста запуска.
NEMOTRON_MODEL=

# Укажи реальный адрес LLM, включая /v1, если он нужен серверу.
LLM_BASE_URL=http://host.docker.internal:8001/v1
LLM_API_KEY=replace-with-your-key
LLM_MODEL=replace-with-your-model

# Отдельный CPU-сервис из services/embeddings.
# Он должен быть подключён к той же Docker-сети, что и app.

# Специальный endpoint токенизации нашего сервиса.
# Это НЕ стандартный endpoint OpenAI.

# Отдельный CPU-сервис из services/embeddings.
# Он должен быть подключён к той же Docker-сети, что и app.
LLM_EMBEDDING_BASE_URL=http://confllm-embeddings:8080/v1
LLM_EMBEDDING_API_KEY=local
LLM_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Специальный endpoint токенизации нашего сервиса.
# Это НЕ стандартный endpoint OpenAI.
LLM_CHUNKING_URL=http://confllm-embeddings:8080/v1/chunks
